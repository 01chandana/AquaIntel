# Required: generate a long random secret (32+ characters).
AQUAINTEL_SECRET_KEY=replace-with-a-long-random-secret/////-
AQUAINTEL_ACCESS_TOKEN_MINUTES=60

# Optional comma-separated origins if the frontend is hosted separately.
# Leave empty when the UI and API use the same origin.
AQUAINTEL_CORS_ORIGINS=

# Optional: defaults to a local SQLite file.
DATABASE_URL=
